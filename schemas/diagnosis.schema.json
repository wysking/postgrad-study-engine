{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgrad-study-engine.local/schemas/diagnosis.schema.json",
  "title": "Postgrad Study Engine diagnosis revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis_id", "question_id", "status", "generated_by"],
  "properties": {
    "diagnosis_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["hypothesized", "confirmed", "rejected", "unresolved"]},
    "generated_by": {"enum": ["codex", "learner", "joint"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "first_divergence": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "error_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "learner_verdict": {"type": "string", "minLength": 1},
    "confirmation_method": {
      "enum": ["draft_check", "learner_recall", "redo", "variant", "delayed_review", "not_confirmed"]
    },
    "supersedes_event_id": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "confirmed"}}},
      "then": {
        "required": ["learner_verdict", "confirmation_method"],
        "properties": {
          "confirmation_method": {"enum": ["draft_check", "learner_recall", "redo", "variant", "delayed_review"]}
        },
        "anyOf": [{"required": ["first_divergence"]}, {"required": ["root_cause"]}]
      }
    }
  ]
}
