{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://postgrad-study-engine.local/schemas/course_package.schema.json",
  "required": [
    "schema_version",
    "course_id",
    "title",
    "fictional",
    "units",
    "probes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "course_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "fictional": {
      "type": "boolean"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "knowledge_unit.schema.json"
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "unit_id",
          "prompt",
          "answer",
          "distinguishes",
          "estimated_minutes"
        ],
        "properties": {
          "probe_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "distinguishes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
